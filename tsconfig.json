{
   "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "DOM",
      "es2018",
      "es2019",
      "es2020",
      "es2021",
    ],      
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./build",
    "strict": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/__tests__/*"]
}